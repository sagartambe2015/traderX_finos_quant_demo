{
  "dependencies": {
    "express": "^4.22.3",
    "kiteconnect": "^5.3.0",
    "tsx": "^4.23.15",
    "ws": "^8.22.0"
  },
  "scripts": {
    "start": "tsx --env-file=.env test.ts",
    "dev": "concurrently -k -n server,web -c blue,magenta \"npm:server\" \"npm:web\"",
    "server": "tsx watch --env-file=.env server/index.ts",
    "web": "npm --prefix web run dev",
    "build": "npm --prefix web run build",
    "serve": "tsx --env-file=.env server/index.ts",
    "typecheck": "tsc -p . && tsc -p web"
  },
  "devDependencies": {
    "@types/express": "^4.17.25",
    "@types/node": "^20.19.43",
    "@types/ws": "^8.18.2",
    "concurrently": "^9.2.5",
    "typescript": "^5.9.3"
  }
}
